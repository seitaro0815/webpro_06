<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>ポケモン一覧</title>
</head>
<body>
  <h2>育成ポケモン一覧</h2>
  <table border="1">
    <tr><th>ID</th><th>ポケモン名</th><th>持ち物</th></tr>
      <% let number = 0 %>
      <% for( let row of data ) { %>
        <tr>
          <td><%= row.id %></td>
          <td><a href="/pokemon/<%= number %>"><%= row.name %></a></td>
          <td><%= row.goods %></td>
        </tr>
        <% number += 1 %>
      <% } %>
  </table>
  <br>
  <a href="/pokemon/create">ポケモンを追加する</a>
</body>
</html>