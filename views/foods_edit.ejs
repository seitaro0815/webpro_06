<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %>の編集</title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>
  <form action="/foods/update/<%= data.id - 1 %>" method="POST">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      
      <tr><td>ID</td><td><input type="text" name="id" value="<%= data.id %>"></td></tr>
      <tr><td>食べ物</td><td><input type="text" name="name" value="<%= data.name %>"></td></tr>
      <tr><td>賞味期限</td><td><input type="text" name="limit" value="<%= data.limit %>"></td></tr>
      <tr><td>個数</td><td><input type="text" name="qty" value="<%= data.qty %>"></td></tr>
      <tr><td>備考</td><td><input type="text" name="memo" value="<%= data.memo %>"></td></tr>
    </table>
    
    <input type="submit" value="更新">
  </form>
  
  <br>
  <a href="/foods/">食材一覧に戻る</a>
</body>
</html>